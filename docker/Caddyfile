# SITE_ADDRESS comes from .env (see docker-compose.yml) instead of being hardcoded in the image, so
# the same image works both for a real production host and for a local test run
# (SITE_ADDRESS=localhost).
#
# auto_https off: TLS isn't handled by Caddy itself, it's terminated by the Cloudflare Tunnel
# (cloudflared) in front of it — Caddy is never directly reachable from the outside, so its own
# Let's Encrypt attempt via HTTP-01 would fail anyway. The tunnel talks to Caddy over plain HTTP
# instead.
{
	auto_https off
}

http://{$SITE_ADDRESS} {
	# Applies to every response below (SPA pages and proxied API alike) — neither the public chat
	# nor the dashboard had any clickjacking/MIME-sniffing protection at any layer before this.
	# No Content-Security-Policy here on purpose: three.js/WebGL avatar rendering, blob: audio
	# playback, and the Tally survey iframe (components/SurveyEmbed) would all need a carefully
	# tuned policy that's genuinely at risk of silently breaking the avatar for every visitor if
	# it's wrong — that needs real browser testing, not a guess, so it's deliberately left for a
	# dedicated follow-up instead of shipped un-verified here.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Harmless if a deployment somehow serves plain HTTP end-to-end: browsers only ever honor
		# this header on a response they received over an actual HTTPS connection (RFC 6797) — it
		# only does anything once the documented Cloudflare Tunnel (or equivalent) is in place.
		Strict-Transport-Security "max-age=15552000"
	}

	# Explicit content-type allowlist instead of Caddy's own default: the streamed chat reply
	# (backend/app/features/chat/pipeline.py::stream_turn, Content-Type: text/event-stream)
	# must NOT be gzip-encoded — it's already base64 audio (barely compressible) sent as a long-
	# lived stream, and holding a compression buffer open across it just burns CPU per student
	# for no space saved.
	encode gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
			# onnxruntime-web's ~27 MB WebAssembly runtime for on-device speech recognition
			# (frontend/src/workers/parakeetWorker.ts) shrinks to ~6 MB.
			header Content-Type application/wasm*
		}
	}

	# Serving under a sub-path (BASE_PATH in .env, e.g. /lola): strip it here, so every handle below
	# and the backend see the same paths as on a site of its own. Requests without the prefix still
	# work, for a proxy in front that strips it itself. The pattern tolerates BASE_PATH written with
	# or without slashes, and an empty BASE_PATH matches everything and rewrites it to itself.
	@prefixed path_regexp prefixed ^/*{$BASE_PATH}/*(.*)$
	rewrite @prefixed /{re.prefixed.1}

	# On-device speech recognition model (see scripts/fetch-stt-model.sh), mounted read-only from
	# the data directory by docker-compose.yml. Every file sits next to a .gz copy the script made
	# once, and `precompressed` sends that copy to any browser that accepts gzip: ~170 MB instead of
	# ~380 MB per device, without compressing anything per request. The version is part of the
	# path, so a file never changes under its URL and may be cached forever.
	handle /models/* {
		root * /
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed gzip
		}
	}

	# The backend serves every route under /api/v1 itself (see backend/app/core/urls.py), so API
	# requests are passed through unchanged — same as locally in frontend/vite.config.ts.
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Also reachable at the bare path, not just /api/v1/health — the URL an external load balancer
	# or monitoring/uptime check would naturally try first. Without this it falls through to the
	# SPA handle below and gets a false "200 OK" from index.html instead of the backend's actual
	# health status, even while the backend container is fully down.
	handle /health {
		reverse_proxy backend:8000
	}

	# Built by the backend because its paths carry BASE_PATH (see backend/app/core/robots.py).
	handle /robots.txt {
		reverse_proxy backend:8000
	}

	# SPA fallback: a direct request for e.g. /c/some-slug still needs to serve index.html, otherwise
	# reloading on a sub-route would be a 404.
	handle {
		root * /srv
		# index.html's <base href> is filled in from BASE_PATH here (see frontend/vite.config.ts),
		# so the same image works at the root and under any sub-path. Only HTML is templated, and
		# index.html is the only HTML file.
		templates {
			mime text/html
		}
		# robots.txt keeps polite crawlers out of the public chat; this keeps a chat link that was
		# posted elsewhere out of search results for bots that fetch it anyway. Matched here, after
		# BASE_PATH has been stripped, and before try_files turns the path into /index.html.
		header /c/* X-Robots-Tag "noindex, nofollow"
		try_files {path} /index.html
		file_server
	}
}
